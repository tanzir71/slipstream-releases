{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slipstream.tanziro.com/schema/edit-plan.v2.json",
  "title": "Slipstream edit plan v2",
  "description": "One project format for Slipstream on macOS, Windows/Linux (Tauri + slipstream_engine) and the web. Times are seconds on the SOURCE timeline unless a field says otherwise. Fractions (padding, radius, sizes, margins) are relative to the output frame's short side. Fields marked x-surfaces are only rendered by those surfaces; every reader must keep fields it does not understand. Unknown top-level keys are allowed so newer writers don't break older readers. In a multi-clip project (segments with `asset`, see sources.clips) there is no single source timeline: zooms, scenes, frameSections, masks, annotations, broll, chapters and brand.lowerThird use OUTPUT seconds, and cuts/range are not applied on top of the segments.",
  "type": "object",
  "required": [
    "version",
    "sources",
    "words",
    "cuts",
    "zooms",
    "frame",
    "layout",
    "style",
    "captions"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 2
    },
    "app": {
      "title": "AppInfo",
      "type": "object",
      "description": "The app that last wrote the plan.",
      "properties": {
        "name": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "macos",
            "tauri",
            "web",
            "engine"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "meta": {
      "title": "PlanMeta",
      "type": "object",
      "description": "Project identity. created/updated are Unix milliseconds (number) or ISO 8601 strings.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "created": {
          "type": [
            "number",
            "string"
          ]
        },
        "updated": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    },
    "sources": {
      "title": "Sources",
      "type": "object",
      "required": [
        "screen"
      ],
      "properties": {
        "screen": {
          "$ref": "#/$defs/source"
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "cameraOffset": {
          "type": "number",
          "description": "Seconds the camera recording started after the screen recording."
        },
        "angles": {
          "type": "array",
          "description": "Extra camera angles beyond sources.camera: separately recorded cameras or remote guests, synced by audio (S-03, S-06).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "offset": {
                "type": "number",
                "description": "Seconds this angle started after the screen recording (negative if before)."
              },
              "speaker": {
                "type": "string",
                "description": "Speaker id this angle follows when switching by speaker."
              },
              "duration": {
                "type": "number"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "clips": {
          "type": "array",
          "description": "Assets of a multi-clip project (ticket AE-01): the footage that segments with `asset` play. In bundles each clip is media/clips/<id>.<ext>. sources.screen then describes the first clip so readers without clip support still find a recording.",
          "items": {
            "$ref": "#/$defs/clip"
          }
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "speakers": {
      "type": "object",
      "description": "Speaker id (e.g. 'S1') to display name and colour. Words point here through word.speaker.",
      "additionalProperties": {
        "$ref": "#/$defs/speaker"
      }
    },
    "cuts": {
      "type": "array",
      "description": "Explicit cut ranges. Cuts from deleted words are derived from words and are not listed here.",
      "items": {
        "$ref": "#/$defs/cut"
      }
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/$defs/range"
        },
        {
          "type": "null"
        }
      ],
      "description": "Clip in/out: everything outside is excluded from export."
    },
    "zooms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zoom"
      }
    },
    "focusKeyframes": {
      "type": "array",
      "x-surfaces": [
        "macos",
        "tauri"
      ],
      "description": "Hand-placed focus points for zooms and reframing (engine focusKeyframes).",
      "items": {
        "$ref": "#/$defs/keyframe"
      }
    },
    "frame": {
      "title": "Frame",
      "type": "object",
      "required": [
        "aspect"
      ],
      "properties": {
        "aspect": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:5"
          ]
        },
        "reframe": {
          "title": "Reframe",
          "type": "object",
          "x-surfaces": [
            "tauri",
            "engine"
          ],
          "description": "Smart reframe for vertical output (engine detect_smart_reframe).",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "anchor": {
              "enum": [
                "center",
                "left",
                "right",
                "auto"
              ]
            },
            "smoothing": {
              "type": "number"
            },
            "focusPath": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyframe"
              }
            }
          }
        },
        "crop": {
          "type": "array",
          "description": "Source crop [x, y, w, h] as fractions of the source frame (top-left origin), applied before layout: the rest of the pipeline sees only this area. Set after an Area recording, or with the editor's Area crop. Zoom focus, masks, annotations and cursor samples stay in fractions of the whole source frame. The web edit keeps it at edit.frame.crop.",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "layout": {
      "title": "Layout",
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "pip",
            "split",
            "screen",
            "camera"
          ]
        },
        "corner": {
          "enum": [
            "tl",
            "tr",
            "bl",
            "br"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 0.08,
          "maximum": 0.5
        },
        "shape": {
          "enum": [
            "circle",
            "rounded",
            "square",
            "wide"
          ]
        },
        "mirror": {
          "type": "boolean"
        },
        "split": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 0.7
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "margin": {
          "type": "number",
          "minimum": 0,
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Camera inset from the frame edge, as a fraction of the short side (engine camera.margin)."
        },
        "angle": {
          "type": "string",
          "description": "Camera angle shown (id from sources.angles); defaults to the first camera (ticket S-03)."
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Per-segment layout overrides (ticket S-01).",
      "items": {
        "title": "Scene",
        "type": "object",
        "required": [
          "start",
          "end",
          "layout"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "layout": {
            "$ref": "#/properties/layout"
          }
        }
      }
    },
    "style": {
      "title": "Style",
      "type": "object",
      "properties": {
        "bg": {
          "type": "string",
          "description": "Wallpaper id (tide, morning, sage, sand, dusk, graphite, valley, shore, peaks, dunes), 'solid', 'blur' or 'image'. Legacy 1.x gradient ids map to the closest wallpaper."
        },
        "solid": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "imagePath": {
          "type": "string"
        },
        "padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "Background amount: the space around the recording as a fraction of the short side (presets: tight 0.04, balanced 0.07, roomy 0.12, spacious 0.18)."
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.08
        },
        "shadow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Screen layer scale inside the frame (engine staging.scale)."
        },
        "offsetX": {
          "type": "number",
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Screen layer offset as a fraction of frame width (engine staging.offsetX)."
        },
        "offsetY": {
          "type": "number",
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Screen layer offset as a fraction of frame height (engine staging.offsetY)."
        },
        "frame": {
          "enum": [
            "background",
            "full"
          ],
          "description": "On a background (padding, corners, shadow, wallpaper) or full screen (edge to edge: padding, radius and shadow 0). Missing = background (ticket E-01)."
        },
        "fit": {
          "enum": [
            "fill",
            "fit"
          ],
          "description": "Full screen only: fill crops the recording to the output aspect (cover), fit letterboxes it on the wallpaper (contain). Default fill."
        },
        "followCursor": {
          "type": "boolean",
          "description": "Full screen with fill: the crop follows the cursor (cursor.samples, else the zoom focus) with the auto-zoom smoothing. Default true."
        }
      }
    },
    "cursor": {
      "title": "Cursor",
      "type": "object",
      "x-surfaces": [
        "macos",
        "tauri"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "smoothing": {
          "type": "number"
        },
        "showClicks": {
          "type": "boolean"
        },
        "motionBlur": {
          "type": "boolean"
        },
        "hideHardwareCursor": {
          "type": "boolean"
        },
        "samplesPath": {
          "type": "string",
          "description": "Cursor samples recorded during capture, relative to the project bundle."
        },
        "samples": {
          "type": "array",
          "description": "Cursor samples recorded during capture, inline (the Windows/Linux recorder writes these; macOS uses samplesPath): t in seconds on the screen source, x/y 0..1 of the recorded screen (top-left origin), click on primary-button presses. A pointer at rest is kept as the first and last sample of the stretch.",
          "items": {
            "type": "object",
            "required": [
              "t",
              "x",
              "y"
            ],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "click": {
                "type": "boolean"
              }
            }
          }
        },
        "source": {
          "type": "string",
          "description": "Where the samples came from, e.g. 'desktop' (the Windows/Linux recorder)."
        }
      }
    },
    "captions": {
      "title": "Captions",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "preset": {
          "enum": [
            "studio",
            "cinema",
            "editorial",
            "bold",
            "pop",
            "boxed",
            "karaoke",
            "minimal",
            "neon"
          ],
          "description": "Caption look. 'pop', 'boxed', 'karaoke', 'minimal' and 'neon' are legacy ids from 1.x and map to the new looks."
        },
        "position": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Multiplier on the preset's text size (engine fontScale)."
        },
        "color": {
          "type": "string"
        },
        "uppercase": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Force caps on or off; null follows the preset."
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "description": "Language shown and burned in: null = the transcript, otherwise a key of translations."
        },
        "translations": {
          "type": "object",
          "description": "Translated cues per language code (e.g. 'es').",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cue"
            }
          }
        },
        "cues": {
          "type": "array",
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Explicit cues (desktop caption tracks). When absent, cues are built from words.",
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "fillChoice": {
          "type": "string",
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Desktop text fill option (engine captions.fillChoice)."
        },
        "boxed": {
          "type": "boolean",
          "x-surfaces": [
            "macos",
            "tauri"
          ],
          "description": "Draw a box behind the text (engine captions.boxed)."
        }
      }
    },
    "audio": {
      "title": "Audio",
      "type": "object",
      "properties": {
        "fadeIn": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds."
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds."
        },
        "enhance": {
          "type": "boolean",
          "description": "Studio Sound: noise removal and voice enhancement (tickets T-01, M-01)."
        },
        "loudnessLufs": {
          "type": "number",
          "minimum": -70,
          "maximum": 0,
          "description": "Integrated loudness target, e.g. -14."
        },
        "normalize": {
          "type": "boolean",
          "description": "Normalise integrated loudness to loudnessLufs on export (default true, -14 LUFS)."
        }
      }
    },
    "brand": {
      "title": "Brand",
      "type": "object",
      "description": "Brand kit applied to this project (ticket S-02).",
      "properties": {
        "logo": {
          "title": "BrandLogo",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "description": "Logo image, relative to the project bundle."
            },
            "corner": {
              "enum": [
                "tl",
                "tr",
                "bl",
                "br"
              ]
            },
            "size": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Logo width as a fraction of the frame's short side."
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "lowerThird": {
          "title": "LowerThird",
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "duration": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "broll": {
      "type": "array",
      "items": {
        "title": "BrollOverlay",
        "type": "object",
        "required": [
          "assetId",
          "start",
          "end"
        ],
        "properties": {
          "assetId": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Asset file, relative to the project bundle or absolute on desktop."
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "opacity": {
            "type": "number"
          },
          "fit": {
            "enum": [
              "cover",
              "contain"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ],
            "description": "Defaults to image."
          },
          "area": {
            "enum": [
              "screen",
              "full"
            ],
            "description": "Cover the screen area (default) or the whole frame."
          },
          "trimIn": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds into the clip where playback starts."
          },
          "prompt": {
            "type": "string",
            "description": "Prompt used when the asset was generated."
          },
          "generatedBy": {
            "type": "string",
            "description": "Provider and model that generated the asset, e.g. \"openrouter:google/veo-3.1-lite\"."
          }
        }
      },
      "description": "B-roll images and clips over the screen area or the whole frame (ticket S-04), local or generated with the user's own cloud key."
    },
    "music": {
      "title": "Music",
      "type": "object",
      "description": "Background music bed (ticket S-04). Unlike most fields it lives on the OUTPUT timeline (after cuts), so cuts never chop the song: it starts at `start`, loops if shorter than the video, fades in and out, and ducks under speech (kept words merged across gaps under 0.5 s; smoothstep attack/release). Gain at output time t = volume × fade × (1 − duck × (1 − duckLevel)); see packages/editor-core/src/music.js.",
      "required": [
        "assetId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "description": "Media key of the audio file (web: `<project>:music`; bundles: media/assets/music.<ext>)."
        },
        "path": {
          "type": "string",
          "description": "Audio file, relative to the project bundle or absolute on desktop."
        },
        "type": {
          "type": "string",
          "description": "MIME type of the audio file."
        },
        "name": {
          "type": "string",
          "description": "Display name, e.g. the original file name."
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Output seconds where the music begins. Default 0."
        },
        "trimIn": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds into the song to start from. Default 0."
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Linear gain relative to the voice. Default 0.22."
        },
        "loop": {
          "type": "boolean",
          "description": "Repeat the song (from trimIn) when it's shorter than the video. Default true."
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds. Default 1."
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds, ending at the end of the video. Default 2.5."
        },
        "duck": {
          "type": "boolean",
          "description": "Lower the music while someone speaks. Default true."
        },
        "duckLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gain multiplier while ducked. Default 0.35."
        },
        "prompt": {
          "type": "string",
          "description": "Prompt it was generated from, if any."
        },
        "generatedBy": {
          "type": "string",
          "description": "Provider that generated it (e.g. elevenlabs), if any."
        }
      }
    },
    "masks": {
      "type": "array",
      "description": "Privacy masks (tickets T-03, M-03). rect is [x, y, w, h] as fractions of the source frame.",
      "items": {
        "title": "Mask",
        "type": "object",
        "required": [
          "start",
          "end",
          "rect",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "mode": {
            "enum": [
              "blur",
              "pixelate",
              "solid"
            ]
          },
          "keyframes": {
            "type": "array",
            "items": {
              "title": "MaskKeyframe",
              "type": "object",
              "required": [
                "t",
                "rect"
              ],
              "properties": {
                "t": {
                  "type": "number"
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "description": "Arrows, boxes, highlights and text callouts (tickets T-05, M-05).",
      "items": {
        "title": "Annotation",
        "type": "object",
        "required": [
          "start",
          "end",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "kind": {
            "enum": [
              "arrow",
              "box",
              "highlight",
              "text"
            ]
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "text": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "x-surfaces": [
        "macos",
        "tauri",
        "web"
      ],
      "description": "Output clips. start/end are OUTPUT timeline seconds, sourceIn is the source time at start (in the clip named by `asset`, else the screen recording). Optional; when present they take precedence over words/cuts/range. Without `asset`: flattened NLE clips of the screen recording (macOS 'Flatten cuts to clips', engine NleOp). With `asset`: a multi-clip project (ticket AE-01) whose segments play sources.clips in sequence; a source second lasts 1/speed output seconds.",
      "items": {
        "title": "Segment",
        "type": "object",
        "required": [
          "id",
          "sourceIn",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceIn": {
            "type": "number"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "isGap": {
            "type": "boolean"
          },
          "track": {
            "type": "integer"
          },
          "asset": {
            "type": "string",
            "description": "Clip id from sources.clips."
          },
          "speed": {
            "type": "number",
            "minimum": 0.88,
            "maximum": 1.12,
            "description": "Playback rate (default 1). Auto edit retimes within 0.88-1.12; clips with kept speech stay at 1."
          },
          "crops": {
            "type": "object",
            "description": "Crop per output aspect, [x, y, w, h] as fractions of the source frame (Auto edit reframing, AE-06).",
            "propertyNames": {
              "enum": [
                "16:9",
                "9:16",
                "1:1",
                "4:5"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "photoMotion": {
            "anyOf": [
              {
                "title": "PhotoMotion",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Scale at the segment start."
                  },
                  "to": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Scale at the segment end."
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Photos only: slow push-in, e.g. { from: 1.0, to: 1.08 }."
          },
          "locked": {
            "type": "boolean",
            "description": "Set by any manual change; Auto edit re-solves around locked segments."
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "title": "Chapter",
        "type": "object",
        "required": [
          "start",
          "title"
        ],
        "properties": {
          "start": {
            "type": "number"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "frameSections": {
      "type": "array",
      "description": "Layout track (ticket E-01): sections that switch between on background and full screen. Outside every section style.frame applies. At each section edge padding, radius and shadow ease with smootherstep over transition.dur seconds starting at the edge (the entered section's transition, or the left one's at its end); a cut switches on the frame. See packages/editor-core/src/frame.js.",
      "items": {
        "title": "FrameSection",
        "type": "object",
        "required": [
          "start",
          "end",
          "frame"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "frame": {
            "enum": [
              "background",
              "full"
            ]
          },
          "transition": {
            "title": "FrameTransition",
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "smooth",
                  "cut"
                ],
                "description": "Default smooth."
              },
              "dur": {
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "description": "Seconds, default 0.6."
              }
            }
          }
        }
      }
    },
    "autoEdit": {
      "title": "AutoEdit",
      "type": "object",
      "description": "Auto edit settings and analysis (docs/handover/auto-edit.md), so tweaks and re-solves are stable. Readers that don't run Auto edit keep it as is.",
      "properties": {
        "match": {
          "enum": [
            "beat",
            "motion",
            "both"
          ]
        },
        "length": {
          "title": "AutoEditLength",
          "type": "object",
          "properties": {
            "preset": {
              "type": [
                "string",
                "null"
              ],
              "description": "'auto' (about a quarter of short footage), 'most' (Keep most: no target; readers also accept the older 'keep'), a length such as '30s', '1m', '5m', '10m', '20m', 'song' (with music: the whole song) or 'custom' (uses target). null reads as 'auto'."
            },
            "target": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Target output seconds (null for Keep most)."
            }
          }
        },
        "pace": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "order": {
          "enum": [
            "mine",
            "energy"
          ]
        },
        "cutFirst": {
          "title": "AutoEditCutFirst",
          "type": "object",
          "properties": {
            "pauses": {
              "type": "boolean"
            },
            "retakes": {
              "type": "boolean"
            },
            "idle": {
              "type": "boolean"
            },
            "repeats": {
              "type": "boolean"
            }
          }
        },
        "sentences": {
          "type": "boolean",
          "description": "Don't cut mid-sentence."
        },
        "keepClipSound": {
          "type": "boolean"
        },
        "transitions": {
          "title": "AutoEditTransitions",
          "type": "object",
          "properties": {
            "punch": {
              "type": "boolean"
            },
            "flash": {
              "type": "boolean"
            },
            "sectionFade": {
              "type": "boolean"
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "music": {
          "anyOf": [
            {
              "title": "AutoEditMusic",
              "type": "object",
              "properties": {
                "bpm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "beats": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "downbeats": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "title": "MusicSection",
                    "type": "object",
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "type": "number"
                      },
                      "end": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Beat analysis of edit.music (song seconds); null when the edit was cut without music."
        },
        "result": {
          "type": "object",
          "description": "Web: what the last Auto edit said about itself, for the tweak tools (why per segment, the Left out tray, the keep map). Readers may drop it; the segments are the edit."
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative to the project bundle (e.g. 'media/screen.webm'), or an absolute path on desktop."
        },
        "name": {
          "type": "string",
          "description": "Original file name, for display."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Hex SHA-256 of the media file, checked when a bundle is opened (ticket C-02)."
        },
        "duration": {
          "type": "number"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "hasAudio": {
          "type": "boolean"
        },
        "hasVideo": {
          "type": "boolean"
        },
        "audioTracks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "speaker": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        }
      }
    },
    "word": {
      "type": "object",
      "required": [
        "id",
        "text",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "deleted": {
          "type": "boolean",
          "description": "Cut from the output (engine isCut)."
        },
        "filler": {
          "enum": [
            "hard",
            "soft",
            null
          ]
        },
        "speaker": {
          "type": "string",
          "description": "Key of the top-level speakers map."
        },
        "retake": {
          "type": "string",
          "description": "Group id, set when the word was cut as a repeated take."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clip": {
          "type": "string",
          "description": "Clip id (sources.clips) the word belongs to, in a multi-clip project; start/end are then seconds in that clip."
        }
      }
    },
    "cut": {
      "type": "object",
      "required": [
        "start",
        "end",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "kind": {
          "enum": [
            "manual",
            "silence",
            "retake",
            "ai"
          ]
        }
      }
    },
    "zoom": {
      "type": "object",
      "required": [
        "id",
        "start",
        "end",
        "scale",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 4
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ramp": {
          "type": "number",
          "minimum": 0,
          "description": "Ease-in/out seconds (default 0.65, capped at a third of the zoom)."
        },
        "auto": {
          "type": "boolean",
          "description": "Placed by auto-zoom rather than by hand."
        },
        "follow": {
          "enum": [
            "fixed",
            "cursor"
          ],
          "description": "'cursor' = follow cursor samples (desktop)."
        }
      }
    },
    "keyframe": {
      "type": "object",
      "required": [
        "t",
        "x",
        "y"
      ],
      "properties": {
        "t": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        }
      }
    },
    "cue": {
      "type": "object",
      "required": [
        "start",
        "end",
        "text"
      ],
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "clip": {
      "title": "Clip",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "media": {
          "type": "string",
          "description": "Where the surface keeps the file, e.g. the web media key `<project>:clip:<id>`."
        },
        "path": {
          "type": "string",
          "description": "Relative to the project bundle (media/clips/<id>.<ext>), or an absolute path on desktop."
        },
        "kind": {
          "enum": [
            "video",
            "photo",
            "audio"
          ],
          "description": "Defaults to video. Photos hold for their segment, optionally with photoMotion."
        },
        "name": {
          "type": "string",
          "description": "Original file name, for display."
        },
        "type": {
          "type": "string",
          "description": "MIME type."
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds (video and audio)."
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "number"
        },
        "hasAudio": {
          "type": "boolean"
        },
        "hasVideo": {
          "type": "boolean"
        },
        "hash": {
          "type": "string",
          "description": "Content hash used to cache analysis, e.g. \"sha256:<hex>\"."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "Hex SHA-256 of the file, checked when a bundle is opened."
        }
      }
    }
  }
}